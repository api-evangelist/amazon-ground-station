{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/amazon-ground-station/refs/heads/main/json-structure/ground-station-time-range-structure.json",
  "name": "TimeRange",
  "description": "A time range with a start and end time.",
  "type": "object",
  "properties": {
    "endTime": {
      "allOf": [
        {
          "$ref": "#/components/schemas/Timestamp"
        },
        {
          "description": "Time in UTC at which the time range ends."
        }
      ]
    },
    "startTime": {
      "allOf": [
        {
          "$ref": "#/components/schemas/Timestamp"
        },
        {
          "description": "Time in UTC at which the time range starts."
        }
      ]
    }
  },
  "required": [
    "endTime",
    "startTime"
  ]
}