  "name": "Eirp",
  "description": "Object that represents EIRP.",
  "type": "object",
  "properties": {
    "units": {
      "allOf": [
        {
          "$ref": "#/components/schemas/EirpUnits"
        },
        {
          "description": "Units of an EIRP."
        }
