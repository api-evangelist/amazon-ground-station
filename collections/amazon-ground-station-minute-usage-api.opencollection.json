{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWS Ground Station Agent Minute Usage API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Minute Usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon Ground Station Get Minute Usage",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://groundstation.{region}.amazonaws.com/minute-usage",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns the number of minutes used by account."
        }
      ]
    }
  ],
  "bundled": true
}