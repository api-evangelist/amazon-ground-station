{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWS Ground Station Agent Satellite API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Satellite",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon Ground Station Get Satellite",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://groundstation.{region}.amazonaws.com/satellite/:satelliteId",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "satelliteId",
                "value": "",
                "type": "path",
                "description": "UUID of a satellite."
              }
            ]
          },
          "docs": "Returns a satellite."
        },
        {
          "info": {
            "name": "Amazon Ground Station List Satellites",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://groundstation.{region}.amazonaws.com/satellite",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "maxResults",
                "value": "",
                "type": "query",
                "description": "Maximum number of satellites returned."
              },
              {
                "name": "nextToken",
                "value": "",
                "type": "query",
                "description": "Next token that can be supplied in the next call to get the next page of satellites."
              }
            ]
          },
          "docs": "Returns a list of satellites."
        }
      ]
    }
  ],
  "bundled": true
}