{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/amazon-ground-station/refs/heads/main/json-schema/ground-station-elevation-schema.json",
  "title": "Elevation",
  "description": "Elevation angle of the satellite in the sky during a contact.",
  "type": "object",
  "properties": {
    "unit": {
      "allOf": [
        {
          "$ref": "#/components/schemas/AngleUnits"
        },
        {
          "description": "Elevation angle units."
        }
      ]
    },
    "value": {
      "allOf": [
        {
          "$ref": "#/components/schemas/Double"
        },
        {
          "description": "Elevation angle value."
        }
      ]
    }
  },
  "required": [
    "unit",
    "value"
  ]
}